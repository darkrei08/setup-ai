# Example CPA Usage Keeper settings. setup-ai copies this to keeper.env and never edits it again.
# Same value as remote-management.secret-key in config.yaml.
CPA_MANAGEMENT_KEY=REPLACE_WITH_THE_CPA_MANAGEMENT_KEY
# Password of the dashboard at http://127.0.0.1:8080
LOGIN_PASSWORD=REPLACE_WITH_A_PRIVATE_KEEPER_PASSWORD
TZ=UTC
