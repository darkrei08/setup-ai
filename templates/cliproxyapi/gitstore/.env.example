# Example for the Git-backed layout. setup-ai copies this to .env and never edits it again.
# Create an EMPTY PRIVATE repo for the store (it will hold config.yaml and OAuth account files).
# An empty store repo is bootstrapped from the default template on first start.
GITSTORE_GIT_URL=https://github.com/YOUR_USER/YOUR_PRIVATE_STORE_REPO.git
GITSTORE_GIT_USERNAME=YOUR_USER
# Fine-grained token with Contents read/write on the store repo only.
GITSTORE_GIT_TOKEN=REPLACE_WITH_A_FINE_GRAINED_TOKEN
GITSTORE_GIT_BRANCH=main
# Management panel password, shared by the proxy and Keeper. Example: openssl rand -hex 32
CPA_MANAGEMENT_KEY=REPLACE_WITH_THE_CPA_MANAGEMENT_KEY
# Dashboard password at http://127.0.0.1:8080. Example: openssl rand -hex 16
KEEPER_LOGIN_PASSWORD=REPLACE_WITH_A_PRIVATE_KEEPER_PASSWORD
TZ=UTC
